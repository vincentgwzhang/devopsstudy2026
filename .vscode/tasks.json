{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "zipkin: up",
            "type": "shell",
            "command": "docker compose -f support/zipkin.yaml up -d",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "loki: up",
            "type": "shell",
            "command": "docker compose -f support/loki-compose.yaml up -d",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "verify: full service chain",
            "type": "shell",
            "command": "${workspaceFolder}/support/verify-chain.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
